{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fatir",
  "version": "1.1.1",
  "identifier": "com.advertpreneur.fatir",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fatir",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  }
}
